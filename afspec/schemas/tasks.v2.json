{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-fox.dev/schemas/tasks.v2.json",
  "title": "Tasks",
  "description": "Schema for tasks.json spec artifact (format version 2)",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "spec_id": { "type": "string", "minLength": 1 },
    "spec_name": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "integer", "const": 2 },
    "test_commands": { "$ref": "#/$defs/test_commands" },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" },
      "minItems": 2
    }
  },
  "required": ["$schema", "spec_id", "spec_name", "schema_version", "test_commands", "dependencies", "tasks"],
  "additionalProperties": false,
  "$defs": {
    "test_commands": {
      "type": "object",
      "properties": {
        "all_tests": { "type": "string", "minLength": 1 },
        "linter": { "type": "string", "minLength": 1 },
        "spec_tests": { "type": "string", "minLength": 1 }
      },
      "required": ["all_tests", "linter"],
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "properties": {
        "spec": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["spec", "reason"],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string", "enum": ["implement", "integration"] },
        "title": { "type": "string", "minLength": 1 },
        "criteria": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_]+-REQ-[0-9]+(\\.[0-9]+)?$" },
          "uniqueItems": true
        },
        "tests": {
          "type": "array",
          "items": { "type": "string", "pattern": "^TS-[A-Za-z0-9_]+-[0-9]+$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "steps": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "touches": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "depends_on": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
        "done_when": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "state": { "type": "string", "enum": ["pending", "in_progress", "done", "dropped"] },
        "optional": { "type": "boolean" }
      },
      "required": ["id", "kind", "title", "tests", "steps", "state"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "implement" } } },
          "then": { "required": ["criteria"], "properties": { "criteria": { "minItems": 1 } } }
        }
      ]
    }
  }
}
