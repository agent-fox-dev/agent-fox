{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-fox.dev/schemas/requirements.v2.json",
  "title": "Requirements",
  "description": "Schema for requirements.json spec artifact (format version 2)",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "spec_id": { "type": "string", "minLength": 1 },
    "spec_name": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "integer", "const": 2 },
    "introduction": { "type": "string", "minLength": 1 },
    "glossary": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" },
      "minItems": 1
    },
    "execution_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/execution_path" },
      "minItems": 1
    },
    "external_apis": {
      "type": "array",
      "items": { "$ref": "#/$defs/external_api" }
    }
  },
  "required": ["$schema", "spec_id", "spec_name", "schema_version", "introduction", "requirements", "execution_paths"],
  "additionalProperties": false,
  "$defs": {
    "criterion": {
      "type": "object",
      "description": "One EARS statement. The rendered sentence is derived from pattern, condition, guard, system and action.",
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+-REQ-[0-9]+\\.[0-9]+$" },
        "pattern": {
          "type": "string",
          "enum": ["ubiquitous", "event_driven", "complex_event", "state_driven", "unwanted", "optional"]
        },
        "condition": { "type": "string", "minLength": 1, "description": "The WHEN / WHILE / IF / WHERE clause. Absent for ubiquitous." },
        "guard": { "type": "string", "minLength": 1, "description": "The AND clause. complex_event only." },
        "system": { "type": "string", "minLength": 1, "description": "The acting component. Defaults to \"system\" when rendering." },
        "action": { "type": "string", "minLength": 1 },
        "contract": { "type": "string", "minLength": 1, "description": "What the caller observes. Required for unwanted." }
      },
      "required": ["id", "pattern", "action"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "pattern": { "const": "ubiquitous" } } },
          "then": { "not": { "anyOf": [ { "required": ["condition"] }, { "required": ["guard"] } ] } }
        },
        {
          "if": { "properties": { "pattern": { "const": "complex_event" } } },
          "then": { "required": ["condition", "guard"] }
        },
        {
          "if": { "properties": { "pattern": { "enum": ["event_driven", "state_driven", "unwanted", "optional"] } } },
          "then": { "required": ["condition"], "not": { "required": ["guard"] } }
        },
        {
          "if": { "properties": { "pattern": { "const": "unwanted" } } },
          "then": { "required": ["contract"] }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+-REQ-[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string" },
        "criteria": {
          "type": "array",
          "items": { "$ref": "#/$defs/criterion" },
          "minItems": 1
        }
      },
      "required": ["id", "title", "criteria"],
      "additionalProperties": false
    },
    "path_step": {
      "type": "object",
      "properties": {
        "actor": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 }
      },
      "required": ["actor", "action"],
      "additionalProperties": false
    },
    "execution_path": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_]+-PATH-[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/path_step" },
          "minItems": 2
        }
      },
      "required": ["id", "title", "steps"],
      "additionalProperties": false
    },
    "external_api_symbol": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "import_path": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      },
      "required": ["name", "import_path", "signature"],
      "additionalProperties": false
    },
    "external_api": {
      "type": "object",
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "verified": { "type": "boolean" },
        "symbols": {
          "type": "array",
          "items": { "$ref": "#/$defs/external_api_symbol" },
          "minItems": 1
        }
      },
      "required": ["package", "version", "verified", "symbols"],
      "additionalProperties": false
    }
  }
}
